# Skopiuj ten plik do .env i uzupełnij wartości.
# Plik .env jest ignorowany przez Git – NIE commituj prawdziwych sekretów.

PORT=3000

# Baza MySQL z docker-compose (port 3307 na komputerze)
DATABASE_URL=mysql://root:root@localhost:3307/przychodnia

# Dozwolony adres frontendu (CORS)
CORS_ORIGIN=http://localhost:5173

# Sekrety – wygeneruj losowe wartości, np.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Backend nie uruchomi się z wartościami przykładowymi poniżej.
OTP_SECRET=your_random_secret_here
JWT_SECRET=your_random_jwt_secret_here
JWT_EXPIRES_IN=1h

# Kod SMS: liczba cyfr (dokumentacja: 4)
OTP_LENGTH=4

# console = kod wypisywany w terminalu backendu (development)
SMS_PROVIDER=console

# Adres przychodni pokazywany w potwierdzeniu rezerwacji
CLINIC_ADDRESS=ul. Zdrowa 12, 00-001 Warszawa

# Najpóźniej ile godzin przed wizytą pacjent może ją anulować lub przenieść
CANCEL_DEADLINE_HOURS=2

# Telefon rejestracji podawany w SMS-ach
CLINIC_PHONE=22 123 45 67

# Przypomnienia SMS o wizytach (WF-12) – wymaga db/06_reservation_reminder.sql
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_INTERVAL_MINUTES=15
